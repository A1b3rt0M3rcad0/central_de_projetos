# Server Config
HOMOLOGACAO=False

# AUTH SECRET KEY
SECRET_KEY=your-secret-key-here-change-in-production-min-32-chars
EXPIRE_TIME_TOKEN=48
EXPIRE_TIME_REFRESH_TOKEN=7

# DATABASE CONNECTION (Docker service names)
DATABASE=mysql
DRIVE=pymysql
USERNAME=root
PASSWORD=root_password
HOST=mysql
PORT=3306
DATABASE_NAME=central_de_projetos

# TEST DATABASE CONNECTION
TDATABASE=mysql
TDRIVE=pymysql
TUSERNAME=root
TPASSWORD=root_password
THOST=mysql
TPORT=3306
TDATABASE_NAME=test_central_de_projetos

# MONGODB (Docker service name)
MONGO_HOST=mongodb
MONGO_PORT=27017
MONGO_USERNAME=null
MONGO_PASSWORD=null
MONGO_DB_NAME=central_de_projetos

# TESTE MONGODB
TMONGO_HOST=mongodb
TMONGO_PORT=27017
TMONGO_USERNAME=null
TMONGO_PASSWORD=null
TMONGO_DB_NAME=test_central_de_projetos

# RAVEN DATABASE (Docker service name)
RAVEN_URL=http://ravendb:8080
RAVEN_DATABASE=central_de_projetos
RAVEN_CERTIFICATE_PATH=null
RAVEN_CERTIFICATE_PASSWORD=null

# Redis (Docker service name)
REDIS_URL=redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DECODE_RESPONSES=True
REDIS_SOCKET_CONNECT_TIMEOUT=1.0
REDIS_SOCKET_TIMEOUT=0.5
REDIS_NAMESPACE=imbituba
REDIS_TTL=3600
