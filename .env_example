# ==============================================================================
# ARQUIVO DE CONFIGURAÇÃO DE AMBIENTE - BACKEND
# ==============================================================================
# 
# INSTRUÇÕES:
# 1. Copie este arquivo para .env: cp .env.example .env
# 2. Preencha os valores conforme seu ambiente
# 3. NUNCA commite o arquivo .env no git (já está no .gitignore)
#
# ==============================================================================

# ------------------------------------------------------------------------------
# CONFIGURAÇÃO DO SERVIDOR
# ------------------------------------------------------------------------------
# Define se está em ambiente de homologação/testes
# Valores: True ou False
HOMOLOGACAO=True

# ------------------------------------------------------------------------------
# CONFIGURAÇÃO DE AUTENTICAÇÃO JWT
# ------------------------------------------------------------------------------
# Chave secreta para assinatura dos tokens JWT
# IMPORTANTE: Use uma chave forte e única em produção!
# Mínimo recomendado: 32 caracteres
# Gere uma chave segura: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=your-secret-key-here-change-in-production-min-32-chars

# Tempo de expiração do token de acesso (em horas)
EXPIRE_TIME_TOKEN=48

# Tempo de expiração do refresh token (em dias)
EXPIRE_TIME_REFRESH_TOKEN=7

# ------------------------------------------------------------------------------
# CONFIGURAÇÃO DO BANCO DE DADOS PRINCIPAL (MySQL)
# ------------------------------------------------------------------------------
DATABASE=mysql
DRIVE=pymysql
USERNAME=root
PASSWORD=your_password_here
HOST=localhost
PORT=3306
DATABASE_NAME=central_de_projetos

# ------------------------------------------------------------------------------
# CONFIGURAÇÃO DO BANCO DE DADOS DE TESTES
# ------------------------------------------------------------------------------
TDATABASE=mysql
TDRIVE=pymysql
TUSERNAME=root
TPASSWORD=your_test_password_here
THOST=localhost
TPORT=3306
TDATABASE_NAME=test_central_de_projetos

# ------------------------------------------------------------------------------
# CONFIGURAÇÃO DO MONGODB (Para Logs)
# ------------------------------------------------------------------------------
MONGO_HOST=localhost
MONGO_PORT=27017
MONGO_USERNAME=null
MONGO_PASSWORD=null
MONGO_DB_NAME=central_de_projetos

# ------------------------------------------------------------------------------
# CONFIGURAÇÃO DO MONGODB DE TESTES
# ------------------------------------------------------------------------------
TMONGO_HOST=localhost
TMONGO_PORT=27017
TMONGO_USERNAME=null
TMONGO_PASSWORD=null
TMONGO_DB_NAME=test_central_de_projetos

# ------------------------------------------------------------------------------
# CONFIGURAÇÃO DO RAVENDB (Para Documentos)
# ------------------------------------------------------------------------------
RAVEN_URL=http://localhost:8080
RAVEN_DATABASE=new_data_base
RAVEN_CERTIFICATE_PATH=null
RAVEN_CERTIFICATE_PASSWORD=null

# ------------------------------------------------------------------------------
# CONFIGURAÇÃO DO REDIS (Para Cache)
# ------------------------------------------------------------------------------
# NOTA: Redis está implementado mas NÃO está sendo usado atualmente na aplicação
# Estas variáveis são mantidas para uso futuro
# 
# Se você não vai usar Redis, pode deixar os valores padrão ou remover
REDIS_URL=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DECODE_RESPONSES=True
REDIS_SOCKET_CONNECT_TIMEOUT=1.0
REDIS_SOCKET_TIMEOUT=0.5
REDIS_NAMESPACE=imbituba
REDIS_TTL=3600

# ------------------------------------------------------------------------------
# CONFIGURAÇÃO DE CORS (Cross-Origin Resource Sharing)
# ------------------------------------------------------------------------------
# URLs permitidas para fazer requisições ao backend
# 
# FORMATO: Separe múltiplas URLs por vírgula (sem espaços)
# 
# EXEMPLOS:
#   Desenvolvimento local:
#     CORS_ORIGINS=http://localhost:5173,http://localhost:3000
#   
#   Produção:
#     CORS_ORIGINS=https://app.example.com,https://www.example.com
#
# IMPORTANTE: 
#   - Se não definido, usa fallback para desenvolvimento local
#   - Em produção, SEMPRE defina esta variável!
#   - Não inclua barra no final das URLs
CORS_ORIGINS=

# ------------------------------------------------------------------------------
# CONFIGURAÇÃO DO USUÁRIO ADMINISTRADOR INICIAL
# ------------------------------------------------------------------------------
# Credenciais do primeiro administrador do sistema
# Este usuário será criado automaticamente na primeira execução
ADMIN_CPF=01132533970
ADMIN_EMAIL=admin@admin.com
ADMIN_NAME=Administrador
ADMIN_PASSWORD=Admin@123

# ==============================================================================
# NOTAS ADICIONAIS
# ==============================================================================
#
# 1. VALORES "null":
#    - Alguns campos aceitam "null" como string quando não são necessários
#    - Exemplo: MONGO_USERNAME=null (sem autenticação)
#
# 2. DOCKER:
#    - Ao usar docker-compose, os HOSTs devem ser os nomes dos serviços
#    - Exemplo: HOST=mysql (não localhost) dentro do container
#
# 3. PRODUÇÃO:
#    - Altere SECRET_KEY para um valor seguro e único
#    - Configure CORS_ORIGINS com as URLs de produção
#    - Use senhas fortes para todos os bancos de dados
#    - Não use valores padrão em produção
#
# ==============================================================================
